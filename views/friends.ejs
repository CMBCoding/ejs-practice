<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Friends</title>
</head>
<!-- Include partials -->
<%- include('partials/header') %>
<body>
    <h1>Your friends</h1>
    <ul>
        <% friends.forEach(friend => { %>
            <li><%= friend %></li>
        <% }) %>
    </ul>
    <h2>Favorite Movies</h2>
    <ol>
        <% movies.forEach(movie => { %>
            <li><%= movie %></li>
        <% }) %>
    </ol>
</body>
<!-- Include partials -->
<%- include('partials/footer') %>
</html>