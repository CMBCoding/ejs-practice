<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>
<body>
    <h1>EJS Practice</h1>
    <h2>Hello, <%= person.name %></h2>
    <h3>Occupation: <%= person.occupation %></h3>
    <% if (['plumber', 'organist', 'bagpiper'].includes(person.occupation.toLowerCase())) { %>
        <p>You work the pipes!</p>
    <% } else { %>
        <p>That's an interesting job!</p>
    <% } %>
    <h3>Favorite color: <%= person.favoriteColor %></h3>
    <% if (['red', 'white', 'blue'].includes(person.favoriteColor.toLowerCase())) { %>
        <p>One of the Star-spangled colors!</p>
    <% } else { %>
        <p>That's a cool color too!</p>
    <% } %>

 </body>
</html>